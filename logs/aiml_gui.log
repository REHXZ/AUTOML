(df, columns=cat_cols, drop_first=False, prefix=cat_cols)\n\n# Linear interactions\nif 'Sex_male' in df.columns and 'Pclass' in df.columns:\n    df['Sex_male_x_Pclass'] = df['Sex_male'] * df['Pclass']\nif 'FareLog1p' in df.columns and 'Pclass' in df.columns:\n    df['FareLog1p_x_Pclass'] = df['FareLog1p'] * df['Pclass']\n\nfor col in df.select_dtypes(include=['float64', 'int64', 'int32', 'int16', 'uint8']).columns:\n    if df[col].isna().any():\n        df[col] = df[col].fillna(df[col].median())\n"} new_name=titanic_linear_variant_binned
