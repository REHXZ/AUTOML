2026-05-22 14:53:14 INFO     [aiml_discovery.agents.feature_engineering_agent] create_derived | source=monthly_sku_demand operation=execute_python params={'code': "df = df.copy()\nimport pandas as pd\nimport numpy as np\n\n# Parse YYYYMM-like month key to month-start timestamp\ns = df['request_month_corrected'].astype(str).str.replace(r'\\.0$','', regex=True).str.zfill(6)\ndf['request_month_corrected'] = pd.to_datetime(s + '01', format='%Y%m%d', errors='coerce')\n\n# Keep core columns and aggregate defensively in case of duplicates\nagg_cols = {'qty':'sum'}\nif 'shimano_order_no' in df.columns:\n    agg_cols['shimano_order_no'] = 'nunique'\n\ndf = df.groupby(['shimano_part_no','request_month_corrected'], as_index=False).agg(agg_cols)\n\n# Build dense monthly panel per SKU across each SKU's observed span\nparts = []\nfor sku, g in df.groupby('shimano_part_no', dropna=False):\n    g = g.sort_values('request_month_corrected')\n    if g['request_month_corrected'].notna().any():\n        idx = pd.date_range(g['request_month_corrected'].min(), g['request_month_corrected'].max(), freq='MS')\n        base = pd.DataFrame({'request_month_corrected': idx})\n        base['shimano_part_no'] = sku\n        g2 = base.merge(g, on=['shimano_part_no','request_month_corrected'], how='left')\n        for c in ['qty','shimano_order_no']:\n            if c in g2.columns:\n                g2[c] = g2[c].fillna(0)\n        parts.append(g2)\n\ndf = pd.concat(parts, ignore_index=True) if parts else df\n\n# Calendar features from forecast-origin month only\nfor c in ['request_month_corrected']:\n    df[c] = pd.to_datetime(df[c], errors='coerce')\n\ndf['month_num'] = df['request_month_corrected'].dt.month\ndf['quarter'] = df['request_month_corrected'].dt.quarter\ndf['year'] = df['request_month_corrected'].dt.year\n\n# Sort for panel time features\nsort_cols = ['shimano_part_no','request_month_corrected']\ndf = df.sort_values(sort_cols).reset_index(drop=True)\n\n# Lag features on target\nfor lag in [1,2,3,6,12]:\n    df[f'qty_lag_{lag}'] = df.groupby('shimano_part_no')['qty'].shift(lag)\n\n# Rolling features using only prior months via shift(1)\ngrp = df.groupby('shimano_part_no')['qty']\nqty_prev = grp.shift(1)\ndf['qty_roll_3_mean'] = qty_prev.groupby(df['shimano_part_no']).rolling(3, min_periods=1).mean().reset_index(level=0, drop=True)\ndf['qty_roll_3_sum'] = qty_prev.groupby(df['shimano_part_no']).rolling(3, min_periods=1).sum().reset_index(level=0, drop=True)\ndf['qty_roll_6_mean'] = qty_prev.groupby(df['shimano_part_no']).rolling(6, min_periods=1).mean().reset_index(level=0, drop=True)\ndf['qty_roll_6_sum'] = qty_prev.groupby(df['shimano_part_no']).rolling(6, min_periods=1).sum().reset_index(level=0, drop=True)\n\n# One-step-ahead target\ndf['qty_lead_1'] = df.groupby('shimano_part_no')['qty'].shift(-1)\n\n# Keep keys for chronological split and plotting in final dataset\nkeep = ['request_month_corrected','shimano_part_no','qty']\nif 'shimano_order_no' in df.columns:\n    keep.append('shimano_order_no')\nkeep += ['month_num','quarter','year','qty_lag_1','qty_lag_2','qty_lag_3','qty_lag_6','qty_lag_12','qty_roll_3_mean','qty_roll_3_sum','qty_roll_6_mean','qty_roll_6_sum','qty_lead_1']\ndf = df[keep]\n"} new_name=monthly_sku_demand_forecast_ready
