2026-05-24 22:52:58 INFO     [aiml_discovery.agents.feature_engineering_agent] create_derived | source=titanic_modelling_ready_v1 operation=execute_python params={'code': "df = df.copy()\n\n# Keep all current safe preprocessing from v1 and add only low-cardinality interactions.\n# Sex x Pclass: captures the well-known non-linear survival pattern by social class.\nif 'Sex' in df.columns and 'Pclass' in df.columns:\n    df['Sex_Pclass'] = df['Sex'].astype(str) + '_' + df['Pclass'].astype(str)\n\n# Sex x fare bucket: captures that fare may matter differently by sex while avoiding a high-cardinality continuous interaction.\nif 'Sex' in df.columns and 'Fare' in df.columns:\n    fare_bins = pd.qcut(df['Fare'].rank(method='first'), q=4, labels=['fare_q1','fare_q2','fare_q3','fare_q4'])\n    df['FareBucket'] = fare_bins.astype(str)\n    df['Sex_FareBucket'] = df['Sex'].astype(str) + '_' + df['FareBucket'].astype(str)\n\n# Class x family size bucket: family effects often differ by class, and bucketing keeps the feature compact.\nif 'Pclass' in df.columns and 'FamilySize' in df.columns:\n    family_bucket = pd.cut(df['FamilySize'], bins=[-0.1, 1, 3, 20], labels=['solo','small_family','large_family'])\n    df['FamilySizeBucket'] = family_bucket.astype(str)\n    df['Pclass_FamilySizeBucket'] = df['Pclass'].astype(str) + '_' + df['FamilySizeBucket'].astype(str)\n\n# Bucketed age feature: coarse age bands are often useful for tree-free linear models without leaking exact age granularity.\nif 'Age' in df.columns:\n    age_bucket = pd.cut(df['Age'], bins=[-0.1, 12, 18, 35, 60, 120], labels=['child','teen','young_adult','adult','senior'])\n    df['AgeBucket'] = age_bucket.astype(str)\n\n# Ensure all new categoricals are treated as strings and missing values are explicit.\nfor c in ['Sex_Pclass','FareBucket','Sex_FareBucket','FamilySizeBucket','Pclass_FamilySizeBucket','AgeBucket']:\n    if c in df.columns:\n        df[c] = df[c].fillna('missing').astype(str)\n\n# One-hot encode only the newly created low-cardinality categorical interactions/buckets.\nnew_cat_cols = [c for c in ['Sex_Pclass','FareBucket','Sex_FareBucket','FamilySizeBucket','Pclass_FamilySizeBucket','AgeBucket'] if c in df.columns]\ndf = pd.get_dummies(df, columns=new_cat_cols, drop_first=False)\n\n# Keep all rows and preserve existing target/model columns; sort columns for stability.\ndf = df.reindex(sorted(df.columns), axis=1)"} new_name=titanic_modelling_ready_v2_interactions
