  ord_pivot.columns = [f'n_orders_mb_{int(c)}' for c in ord_pivot.columns]\n    ord_pivot = ord_pivot.reset_index()\n\n    feat = base.merge(qty_pivot, on='request_month_corrected', how='left').merge(ord_pivot, on='request_month_corrected', how='left')\nelse:\n    feat = base.copy()\n\n# Cumulative as-of booking quantities/orders known before target month at selected cutoffs\ncutoffs = [0, 1, 2, 3, 6, 9, 12]\nvalid = work.dropna(subset=['months_before_num']).copy()\nfor c in cutoffs:\n    tmp = valid[valid['months_before_num'] >= c].groupby('request_month_corrected', dropna=False).agg(\n        **{f'cum_booked_qty_mb_ge_{c}': ('qty', 'sum'),\n           f'cum_n_orders_mb_ge_{c}': ('shimano_order_no', pd.Series.nunique)}\n    ).reset_index()\n    feat = feat.merge(tmp, on='request_month_corrected', how='left')\n\n# Lead-time dispersion from order_entry_month relative to request month, if available\nif 'order_entry_month' in work.columns:\n    oe = work.dropna(subset=['request_month_corrected', 'order_entry_month']).copy()\n    if len(oe) > 0:\n        lead_months = ((oe['request_month_corrected'].dt.year - oe['order_entry_month'].dt.year) * 12 +\n                       (oe['request_month_corrected'].dt.month - oe['order_entry_month'].dt.month))\n        oe['lead_months_calc'] = lead_months\n        lead = oe.groupby('request_month_corrected', dropna=False).agg(\n            lead_months_mean=('lead_months_calc', 'mean'),\n            lead_months_std=('lead_months_calc', 'std'),\n            lead_months_median=('lead_months_calc', 'median')\n        ).reset_index()\n        feat = feat.merge(lead, on='request_month_corrected', how='left')\n\n# Calendar features from target month\nfeat['target_month_num'] = feat['request_month_corrected'].dt.month\nfeat['target_quarter'] = feat['request_month_corrected'].dt.quarter\nfeat['target_year'] = feat['request_month_corrected'].dt.year\n\n# Fill feature missings with zero for booking buckets; preserve target month/date\nfor col in feat.columns:\n    if col != 'request_month_corrected' and feat[col].dtype.kind in 'biufc':\n        feat[col] = feat[col].fillna(0)\n\n# Sort chronologically\nfeat = feat.sort_values('request_month_corrected').reset_index(drop=True)\n\ndf = feat"} new_name=monthly_booking_curve_features
