2026-05-24 22:01:57 INFO     [aiml_discovery.agents.feature_engineering_agent] create_derived | source=titanic_dataset operation=execute_python params={'code': "df = df.copy()\nimport pandas as pd\nimport numpy as np\n\n# Preserve target and create core engineered features\n\ndef extract_title(name):\n    if pd.isna(name):\n        return np.nan\n    import re\n    m = re.search(r',\\s*([^\\.]+)\\.', str(name))\n    return m.group(1).strip() if m else np.nan\n\n# Title from Name\nif 'Name' in df.columns:\n    df['Title'] = df['Name'].apply(extract_title)\n    df['Title'] = df['Title'].replace({'Mlle': 'Miss', 'Ms': 'Miss', 'Mme': 'Mrs'})\n    rare_titles = ['Lady','Countess','Capt','Col','Don','Dr','Major','Rev','Sir','Jonkheer','Dona']\n    df['Title'] = df['Title'].where(~df['Title'].isin(rare_titles), 'Rare')\n\n# Family size and alone flag\nfor c in ['SibSp','Parch']:\n    if c not in df.columns:\n        df[c] = 0\n\ndf['FamilySize'] = df['SibSp'].fillna(0) + df['Parch'].fillna(0) + 1\ndf['IsAlone'] = (df['FamilySize'] == 1).astype(int)\n\n# Cabin features\nif 'Cabin' in df.columns:\n    df['CabinMissing'] = df['Cabin'].isna().astype(int)\n    df['Deck'] = df['Cabin'].astype(str).str[0].replace('n', np.nan)\n    df.loc[df['Cabin'].isna(), 'Deck'] = 'Missing'\nelse:\n    df['CabinMissing'] = 1\n    df['Deck'] = 'Missing'\n\n# Ticket features\nif 'Ticket' in df.columns:\n    ticket_counts = df['Ticket'].astype(str).value_counts()\n    df['TicketGroupSize'] = df['Ticket'].astype(str).map(ticket_counts).fillna(1).astype(int)\n    def ticket_prefix(t):\n        t = str(t)\n        # Keep alphabetic prefix if present; otherwise 'Numeric'\n        prefix = ''.join([ch for ch in t if ch.isalpha()]).strip().replace('.', '').replace('/', '').upper()\n        return prefix if prefix else 'Numeric'\n    df['TicketPrefix'] = df['Ticket'].apply(ticket_prefix)\nelse:\n    df['TicketGroupSize'] = 1\n    df['TicketPrefix'] = 'Unknown'\n\n# Fare transform\nif 'Fare' in df.columns:\n    df['Fare_log1p'] = np.log1p(df['Fare'].clip(lower=0))\n\n# Age imputation using grouped medians based on Title, Sex, Pclass, then fallback medians\nif 'Age' in df.columns:\n    if all(col in df.columns for col in ['Title','Sex','Pclass']):\n        grp_median = df.groupby(['Title','Sex','Pclass'])['Age'].transform('median')\n        title_sex_median = df.groupby(['Title','Sex'])['Age'].transform('median')\n        sex_pclass_median = df.groupby(['Sex','Pclass'])['Age'].transform('median')\n        overall_median = df['Age'].median()\n        df['Age'] = df['Age'].fillna(grp_median).fillna(title_sex_median).fillna(sex_pclass_median).fillna(overall_median)\n    else:\n        df['Age'] = df['Age'].fillna(df['Age'].median())\n\n# One-hot encode model-ready categoricals\ncat_cols = [c for c in ['Sex','Embarked','Pclass','Title','Deck','TicketPrefix'] if c in df.columns]\ndf = pd.get_dummies(df, columns=cat_cols, drop_first=False, dummy_na=False)\n\n# Drop raw identifier and high-cardinality text fields not needed after extraction\nfor c in ['PassengerId','Name','Cabin','Ticket']:\n    if c in df.columns:\n        df = df.drop(columns=[c])\n\n# Keep target explicitly\nif 'Survived' in df.columns:\n    cols = ['Survived'] + [c for c in df.columns if c != 'Survived']\n    df = df[cols]\n"} new_name=titanic_features_base
