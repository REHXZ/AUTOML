fillna(age_group_median)\n    if df['Age'].isna().any():\n        df['Age'] = df['Age'].fillna(df['Age'].median())\n\nif 'Fare' in df.columns:\n    df['Fare'] = df['Fare'].fillna(df['Fare'].median())\n    df['log1p_Fare'] = np.log1p(df['Fare'])\n\nfor c in ['SibSp', 'Parch', 'FamilySize', 'TicketGroup']:\n    if c in df.columns and (df[c].fillna(0) >= 0).all():\n        df[f'log1p_{c}'] = np.log1p(df[c].fillna(0))\n\ncols_to_drop = [c for c in ['PassengerId', 'Name', 'Cabin', 'Ticket'] if c in df.columns]\ndf = df.drop(columns=cols_to_drop)\n"} new_name=titanic_tree_ready
