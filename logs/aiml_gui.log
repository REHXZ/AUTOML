2026-05-24 22:48:27 INFO     [aiml_discovery.agents.feature_engineering_agent] create_derived | source=titanic_dataset operation=execute_python params={'code': "df = df.copy()\n\n# Preserve target\n# Engineer family features\nif 'SibSp' in df.columns and 'Parch' in df.columns:\n    df['FamilySize'] = df['SibSp'].fillna(0) + df['Parch'].fillna(0) + 1\n    df['IsAlone'] = (df['FamilySize'] == 1).astype(int)\n\n# Extract title from Name\nif 'Name' in df.columns:\n    df['Title'] = df['Name'].astype(str).str.extract(r',\\s*([^\\.]+)\\.', expand=False).fillna('Unknown').str.strip()\n    # Normalize rare titles\n    df['Title'] = df['Title'].replace({'Mlle': 'Miss', 'Ms': 'Miss', 'Mme': 'Mrs', 'Lady': 'Rare', 'Countess': 'Rare', 'Capt': 'Rare', 'Col': 'Rare', 'Don': 'Rare', 'Dr': 'Rare', 'Major': 'Rare', 'Rev': 'Rare', 'Sir': 'Rare', 'Jonkheer': 'Rare', 'Dona': 'Rare'})\n\n# Cabin-derived features\nif 'Cabin' in df.columns:\n    cabin_str = df['Cabin'].astype(str)\n    df['HasCabin'] = (~df['Cabin'].isna() & (cabin_str.str.lower() != 'nan') & (cabin_str.str.strip() != '')).astype(int)\n    df['CabinDeck'] = df['Cabin'].astype(str).str.extract(r'([A-Za-z])', expand=False).fillna('Unknown')\n    df.loc[df['HasCabin'] == 0, 'CabinDeck'] = 'Unknown'\n\n# Age imputation with median + missing indicator\nif 'Age' in df.columns:\n    df['Age_missing'] = df['Age'].isna().astype(int)\n    age_median = df['Age'].median()\n    df['Age'] = df['Age'].fillna(age_median)\n\n# Fare log transform\nif 'Fare' in df.columns:\n    df['Fare'] = np.log1p(df['Fare'].clip(lower=0))\n\n# Treat Pclass as ordinal (numeric), ensure integer if present\nif 'Pclass' in df.columns:\n    df['Pclass'] = df['Pclass'].astype('Int64')\n\n# Drop raw identifier/high-cardinality columns from modelling features, keep Survived as target\ncols_to_drop = [c for c in ['PassengerId', 'Name', 'Ticket', 'Cabin'] if c in df.columns]\ndf = df.drop(columns=cols_to_drop)\n\n# Basic missing handling for remaining fields\n# Fill categorical missing values to preserve rows before one-hot encoding\nfor col in df.select_dtypes(include=['object', 'category']).columns:\n    df[col] = df[col].fillna('Unknown')\n\n# Impute any remaining numeric missing values with median (preserve all rows)\nfor col in df.select_dtypes(include=['number']).columns:\n    if col != 'Survived' and df[col].isna().any():\n        df[col] = df[col].fillna(df[col].median())\n\n# One-hot encode Sex, Embarked, Title, CabinDeck\ncat_cols = [c for c in ['Sex', 'Embarked', 'Title', 'CabinDeck'] if c in df.columns]\ndf = pd.get_dummies(df, columns=cat_cols, drop_first=False)\n\n# Convert boolean columns to int for modelling consistency\nfor col in df.columns:\n    if df[col].dtype == bool:\n        df[col] = df[col].astype(int)\n"} new_name=titanic_modelling_ready_v1
