 recency indicators derivable from lags only\nfor needed in [('qty_lag_1','qty_lag_2','sold_last_1_not_2_flag'),('qty_lag_1','qty_lag_3','sold_last_1_not_3_flag'),('qty_lag_1','qty_lag_6','sold_last_1_not_6_flag')]:\n    a,b,name = needed\n    if a in df.columns and b in df.columns:\n        av = pd.to_numeric(df[a], errors='coerce').fillna(0)\n        bv = pd.to_numeric(df[b], errors='coerce').fillna(0)\n        df[name] = ((av > 0) & (bv == 0)).astype('Int64')\n\n# Trend / seasonal ratios from leak-safe history features only\nif 'qty_lag_1' in df.columns and 'qty_roll_3_mean' in df.columns:\n    denom = pd.to_numeric(df['qty_roll_3_mean'], errors='coerce').replace(0, np.nan)\n    num = pd.to_numeric(df['qty_lag_1'], errors='coerce')\n    df['qty_lag1_to_roll3_mean_ratio'] = num / denom\nif 'qty_roll_3_mean' in df.columns and 'qty_roll_6_mean' in df.columns:\n    denom = pd.to_numeric(df['qty_roll_6_mean'], errors='coerce').replace(0, np.nan)\n    num = pd.to_numeric(df['qty_roll_3_mean'], errors='coerce')\n    df['qty_roll3_to_roll6_mean_ratio'] = num / denom\nif 'order_count_roll_3_mean' in df.columns and 'order_count_roll_6_mean' in df.columns:\n    denom = pd.to_numeric(df['order_count_roll_6_mean'], errors='coerce').replace(0, np.nan)\n    num = pd.to_numeric(df['order_count_roll_3_mean'], errors='coerce')\n    df['order_count_roll3_to_roll6_mean_ratio'] = num / denom\nif 'line_count_roll_3_mean' in df.columns and 'line_count_roll_6_mean' in df.columns:\n    denom = pd.to_numeric(df['line_count_roll_6_mean'], errors='coerce').replace(0, np.nan)\n    num = pd.to_numeric(df['line_count_roll_3_mean'], errors='coerce')\n    df['line_count_roll3_to_roll6_mean_ratio'] = num / denom\n\n# Intensity / consistency signals from existing leak-safe rolling and lagged counts\nif 'order_count_lag_1' in df.columns and 'line_count_lag_1' in df.columns:\n    denom = pd.to_numeric(df['order_count_lag_1'], errors='coerce').replace(0, np.nan)\n    num = pd.to_numeric(df['line_count_lag_1'], errors='coerce')\n    df['lines_per_order_lag_1'] = num / denom\nif 'order_count_roll_3_sum' in df.columns and 'line_count_roll_3_sum' in df.columns:\n    denom = pd.to_numeric(df['order_count_roll_3_sum'], errors='coerce').replace(0, np.nan)\n    num = pd.to_numeric(df['line_count_roll_3_sum'], errors='coerce')\n    df['lines_per_order_roll_3'] = num / denom\nif 'qty_roll_3_sum' in df.columns and 'line_count_roll_3_sum' in df.columns:\n    denom = pd.to_numeric(df['line_count_roll_3_sum'], errors='coerce').replace(0, np.nan)\n    num = pd.to_numeric(df['qty_roll_3_sum'], errors='coerce')\n    df['qty_per_line_roll_3'] = num / denom\n\n# Keep rows unchanged; no row exclusion\n"} new_name=monthly_product_forecasting_features_leaksafe_ft_v1
