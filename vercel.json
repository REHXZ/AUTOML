{
  "buildCommand": "cd react-frontend && npm install && npm run build",
  "outputDirectory": "react-frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://automl-backend-ishk.onrender.com/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
