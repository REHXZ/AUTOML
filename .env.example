# ─── LLM Provider Configuration ────────────────────────────────────────────────
# The backend auto-detects the provider from the env vars present.
# Priority: ANTHROPIC_API_KEY → OPENAI_API_BASE (Azure) → OPENAI_API_KEY → OLLAMA_BASE_URL
# You can also select and configure the provider from the UI at runtime.

# ── Option A: Standard OpenAI ──
OPENAI_API_KEY=sk-...
# Optional: override model (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# ── Option B: Azure OpenAI ──
# OPENAI_API_KEY=<your-azure-key>
# OPENAI_API_BASE=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ── Option C: Anthropic ──
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: override model (default: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# ── Option D: Ollama (local, no key needed) ──
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3

# ─── Supabase Auth (optional — enables login and per-user data isolation) ────────
# Get these from your Supabase project: Settings → API

# Frontend: Supabase URL and anon key (exposed to browser — safe)
# VITE_SUPABASE_URL=https://<project>.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Backend: JWT secret used to verify user tokens (never expose this)
# Found at: Supabase project → Settings → API → JWT Settings → JWT Secret
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Backend: Supabase storage (optional — SQLite is used when not set)
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_ANON_KEY=eyJ...

# ─── App settings ───────────────────────────────────────────────────────────────
# Optional: override data storage location (default: ~/.aiml_discovery/)
# AIML_DISCOVERY_HOME=/path/to/storage

# Optional: API server bind settings
# API_HOST=0.0.0.0
# API_PORT=8082
